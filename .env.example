# Build-time settings for the online features (leaderboard and "Report a problem").
# Set them in the environment of `npm run build` (or your host's build settings). Without both, the
# game builds with online features switched off and makes no requests to any API.

# Base URL of your deployed Worker from server/ (no trailing slash).
GS_API_BASE=https://api.example

# Comma list of the exact origins the game is served from. Online features turn on only there.
# The same list belongs in the Worker's ALLOWED_ORIGINS (server/wrangler.toml).
GS_ALLOWED_ORIGINS=https://game.example,https://www.game.example
